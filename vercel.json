{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/medicines/:id",
      "destination": "/api/medicines.js"
    },
    {
      "source": "/api/medicines",
      "destination": "/api/medicines.js"
    },
    {
      "source": "/api/verify/:batchNo",
      "destination": "/api/verify.js"
    },
    {
      "source": "/api/verify",
      "destination": "/api/verify.js"
    },
    {
      "source": "/api/batches/:id",
      "destination": "/api/batches.js"
    },
    {
      "source": "/api/batches",
      "destination": "/api/batches.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
